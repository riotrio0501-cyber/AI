{
  "title": "娘の彼氏が泊まりに来た夜、\n台所から怪しい声が聞こえてきた",
  "lines": [
    {"speaker": "父", "text": "…彼氏くん。今夜は泊まっていけ", "effect": "none", "emotion": "ふつう"},
    {"speaker": "彼氏", "text": "あ、ありがとうございます！", "effect": "none", "emotion": "喜び"},
    {"speaker": "父", "text": "ただし、娘の部屋には近づくな", "effect": "zoom", "emotion": "怒り"},
    {"speaker": "彼氏", "text": "も、もちろんです！", "effect": "none", "emotion": "おびえ"},
    {"speaker": "娘", "text": "ねえお母さん、これ太すぎて入らないよ…", "effect": "pause", "shot": "台所の戸", "muffle": true, "se": "don", "emotion": "悲しみ"},
    {"speaker": "父", "text": "……", "effect": "zoom", "shot": "固まる", "pause": 1.4, "emotion": "おびえ"},
    {"speaker": "母", "text": "大丈夫。力を抜いて、ゆっくり奥まで入れるの", "effect": "none", "shot": "台所の戸", "muffle": true, "emotion": "喜び"},
    {"speaker": "彼氏", "text": "（小声）え…何の話…？", "effect": "none", "volume": 0.7, "speed": 1.15, "emotion": "おびえ"},
    {"speaker": "娘", "text": "あっ…入った！", "effect": "none", "shot": "台所の戸", "muffle": true, "emotion": "驚き"},
    {"speaker": "母", "text": "ほら、全部入ったでしょ", "effect": "none", "shot": "台所の戸", "muffle": true, "emotion": "喜び"},
    {"speaker": "父", "text": "けしからーん！！", "effect": ["zoom", "shake"], "shot": "帰れ", "se": "don", "emotion": "怒り"},
    {"speaker": "母", "text": "あら、お父さん。どうしたの？", "effect": "pause", "shot": "ネギ鍋", "emotion": "驚き"},
    {"speaker": "娘", "text": "太いネギがお鍋に入らなくてさ", "effect": "none", "emotion": "ふつう"},
    {"speaker": "父", "text": "……", "effect": "zoom", "shot": "固まる", "pause": 1.3, "emotion": "驚き"},
    {"speaker": "娘", "text": "お父さん、何を想像してたの？", "effect": "zoom", "emotion": "嫌悪"},
    {"speaker": "彼氏", "text": "（小声）お父さんも同じこと考えてたんだ…", "effect": "none", "volume": 0.7, "speed": 1.15, "emotion": "おびえ"},
    {"speaker": "母", "text": "あら、お父さん。顔が真っ赤よ", "effect": "pause", "emotion": "喜び"},
    {"speaker": "父", "text": "…芋煮の湯気のせいだ", "effect": "zoom", "shot": "赤面", "se_after": "chan", "emotion": "悲しみ"}
  ]
}
