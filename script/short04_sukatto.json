 "lines": [
  {
   "speaker": "レイカ",
   "text": "ナツミさんのバッグ、それどこの？ 私のはね、海外で買った限定品なの",
   "emotion": "喜び"
  },
  {
   "speaker": "ナツミ",
   "text": "へえ、すごいですね",
   "emotion": "ふつう"
  },
  {
   "speaker": "レイカ",
   "text": "うちの旦那、みどり商事の部長でしょ？ 忙しくて大変なのよ〜",
   "emotion": "喜び",
   "yomi": "うちの旦那、みどり商事の部長でしょ？ 忙しくて大変なのよー"
  },
  {
   "speaker": "レイカ",
   "text": "ナツミさんの旦那さんは、何してるの？",
   "emotion": "ふつう"
  },
  {
   "speaker": "ナツミ",
   "text": "うちは、普通の会社員です",
   "emotion": "ふつう"
  },
  {
   "speaker": "レイカ",
   "text": "あら〜、普通が一番よね〜",
   "emotion": "喜び",
   "shot": "レイカ_ドヤ",
   "yomi": "あらー、普通が一番よねー"
  },
  {
   "speaker": "ナツミ",
   "text": "あ、夫から連絡です",
   "emotion": "ふつう",
   "se": "notify",
   "phone": {
    "type": "notify",
    "from": "夫",
    "text": "今日から来た部長さん、\n奥さんがナツミのママ友なんだって？\nよろしく伝えておいて"
   },
   "gap": 0.6
  },
  {
   "speaker": "レイカ",
   "text": "……え？",
   "emotion": "驚き",
   "gap": 0.8
  },
  {
   "speaker": "ナツミ",
   "text": "夫、みどり商事で社長をしてるんです",
   "emotion": "ふつう",
   "effect": "zoom"
  },
  {
   "speaker": "レイカ",
   "text": "しゃ、社長！？",
   "emotion": "驚き",
   "shot": "レイカ_衝撃",
   "effect": [
    "zoom",
    "shake"
   ],
   "se": "don"
  },
  {
   "speaker": "ナツミ",
   "text": "バッグ、素敵ですね。限定品なんですよね？",
   "emotion": "喜び",
   "shot": "ナツミ_笑顔"
  },
  {
   "speaker": "レイカ",
   "text": "…実はこれ、フリマで三千円でした",
